# Configuración del MCP de estado compartido.
# Copiar a /etc/evastate.env y ajustar. La unidad systemd la carga con
# EnvironmentFile=. Los defaults del código son neutros (example.com):
# TODO despliegue real define estas variables.

# --- servidor (server.py) ---
EVASTATE_DB=/var/lib/evastate/state.db
EVASTATE_PORT=8787
EVASTATE_DOMAIN=example.com
EVASTATE_PUBLIC_HOST=state.example.com
EVASTATE_NAME=estado-mcp
# EVASTATE_PARTICIPANTS=/etc/evastate/participants.json
# EVASTATE_SITES=/var/www/sites
# EVASTATE_APPS=/srv/apps
# EVASTATE_SPOOL=/var/lib/evastate/ctl-spool
# EVASTATE_CTL_OUT=/var/lib/evastate/ctl-out

# --- administración (scripts/participante.py) ---
# EVASTATE_SERVICE=evastate       # unidad a reiniciar tras altas/rotaciones
# EVASTATE_GROUP=evastate         # grupo dueño de participants.json

# --- ayudante root de apps (scripts/eva-app-ctl) ---
# Lee EVASTATE_DOMAIN de este mismo archivo (via EnvironmentFile en
# eva-appd.service) para generar los snippets de Caddy.

# --- batería de pruebas (tests/bateria.py) — se exportan al correrla ---
# BAT_URL_BASE=https://state-test.example.com   # instancia BAJO PRUEBA
# BAT_TOKEN_1=/ruta/al/token/participante1
# BAT_TOKEN_2=/ruta/al/token/participante2
# BAT_TOKEN_AJENO=/ruta/token/de/otra/instancia # opcional: caso de aislamiento
# BAT_SSH="ssh usuario@servidor"                # opcional: caso de restart
# BAT_SERVICIO=evastate-test                    # unidad que reinicia la puerta E
# BAT_PROD=1                                    # SOLO al apuntar a producción (permite únicamente --humo)
