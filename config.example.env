# Configuration for the shared-state MCP server.
# Copy to /etc/evastate.env and adjust. The systemd unit loads it via
# EnvironmentFile=. Code defaults are neutral (example.com): every real
# deployment must set these variables.

# --- server (server.py) ---
EVASTATE_DB=/var/lib/evastate/state.db
EVASTATE_PORT=8787
EVASTATE_DOMAIN=example.com
EVASTATE_PUBLIC_HOST=state.example.com
EVASTATE_NAME=estado-mcp
# EVASTATE_RATE_MAX=240      # per-identity requests per window (429 beyond)
# EVASTATE_RATE_WINDOW=60    # window in seconds
# EVASTATE_PANEL=/opt/evastate/panel.html   # web console page served at /panel
# EVASTATE_PARTICIPANTS=/etc/evastate/participants.json
# EVASTATE_BACKUP_DIR=/var/backups/evastate   # where GET /<TOKEN>/backup reads from
# EVASTATE_SITES=/var/www/sites
# EVASTATE_APPS=/srv/apps
# EVASTATE_SPOOL=/var/lib/evastate/ctl-spool
# EVASTATE_CTL_OUT=/var/lib/evastate/ctl-out

# --- administration (scripts/participante.py) ---
# Authority (who may publish on the bulletin board) is per-participant, not
# an env var: set it at install with `participante.py autoridad <id> on`.
# EVASTATE_SERVICE=evastate       # unit restarted after add/rotate
# EVASTATE_GROUP=evastate         # group owning participants.json

# --- idle apps (scripts/eva-app-idle, via eva-app-idle.timer) ---
# EVA_IDLE_MIN=20                 # minutes without visits before sleeping an app
# EVASTATE_APP_PREFIX=eva-app-    # systemd unit prefix for dynamic apps

# --- root app helper (scripts/eva-app-ctl) ---
# Reads EVASTATE_DOMAIN from this same file (via EnvironmentFile in
# eva-appd.service) to generate the Caddy snippets.

# --- test battery (tests/battery.py) — export when running it ---
# BAT_URL_BASE=https://state-test.example.com   # instance UNDER TEST
# BAT_TOKEN_1=/path/to/participant1.token
# BAT_TOKEN_2=/path/to/participant2.token
# BAT_TOKEN_AJENO=/path/to/other-instance.token # optional: isolation case
# BAT_SSH="ssh user@server"                     # optional: restart case
# BAT_SERVICIO=evastate-test                    # unit gate E restarts
# BAT_PROD=1                                    # ONLY when targeting production (allows --humo only)

# --- Mode -------------------------------------------------------------
# web (default) = a reverse proxy terminates TLS and serves subdomains.
# lan           = no proxy: the server does its own TLS and serves sites.
EVASTATE_MODO=web

# --- Running without a reverse proxy ----------------------------------
# All four default to off; a proxied deployment behaves exactly as before.
#EVASTATE_SERVE_SITES=1              # publish SITES_DIR under /s/<name>/
#EVASTATE_BIND=0.0.0.0               # default 127.0.0.1 (proxy on the same host)
#EVASTATE_TLS_CERT=/etc/evastate/pki/srv.crt
#EVASTATE_TLS_KEY=/etc/evastate/pki/srv.key

# Extra Host headers accepted by the MCP transport, comma separated.
# The SDK answers 421 to anything not listed; PUBLIC_HOST must carry the
# port when it is not 443.
#EVASTATE_EXTRA_HOSTS=state.lan,192.168.1.50:8787
