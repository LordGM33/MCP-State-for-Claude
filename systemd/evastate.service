[Unit]
Description=Estado compartido entre agentes (MCP) v2
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=evastate
Group=evastate
EnvironmentFile=/etc/evastate.env
ExecStart=/opt/evastate/venv/bin/python /opt/evastate/server.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evastate /var/www/sites /srv/apps
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
